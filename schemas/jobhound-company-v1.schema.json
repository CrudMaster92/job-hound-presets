{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["format", "schema_version", "id", "name", "aliases", "website_url", "logo_url", "facets"],
  "properties": {
    "format": {"const": "jobhound-company"}, "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 80},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "legal_name": {"type": ["string", "null"], "maxLength": 200},
    "aliases": {"type": "array", "uniqueItems": true, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "website_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "logo_url": {"type": ["string", "null"], "format": "uri"},
    "availability": {"$ref": "#/$defs/availability"},
    "facets": {"$ref": "#/$defs/facets"}
  },
  "$defs": {
    "availability": {"type": "object", "additionalProperties": false,
      "required": ["status", "reason", "message", "checked_at"],
      "properties": {
        "status": {"const": "unavailable"},
        "reason": {"enum": ["access-restricted", "maintenance", "not-hiring", "regional-restriction", "repair-needed"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 300},
        "checked_at": {"type": "string", "format": "date-time"}
      }
    },
    "facets": {"type": "object", "additionalProperties": false,
    "required": ["industries", "specialties", "tags"],
    "properties": {
      "industries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
      "specialties": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
      "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 40}}
    }}
  }
}
